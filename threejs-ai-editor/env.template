# ========================================
# Three.js AI Editor - 环境变量配置模板
# ========================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 填入实际的配置值
# 3. 不要提交 .env.local 到 Git

# ========================================
# OpenAI 配置（必需）
# ========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ========================================
# 应用配置
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# 后端地址配置（重要！）
# ========================================
# 部署到服务器时，设置为服务器的公网IP或域名
# 本地开发时可以留空或设置为 http://localhost:3000
# 
# 示例：
# NEXT_PUBLIC_BACKEND_URL=http://47.95.159.189
# NEXT_PUBLIC_BACKEND_URL=https://your-domain.com
NEXT_PUBLIC_BACKEND_URL=

# ========================================
# Hyper3D API 配置（可选）
# ========================================
# 如果使用3D模型生成功能，需要配置
HYPER3D_API_KEY=your-hyper3d-api-key-here

# ========================================
# 数据库配置（可选）
# ========================================
# ChromaDB 默认使用本地存储，无需额外配置
# 如果需要使用远程 ChromaDB，可以配置：
# CHROMA_DB_URL=http://your-chromadb-server:8000

# ========================================
# 其他配置
# ========================================
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否启用调试模式
DEBUG=false

